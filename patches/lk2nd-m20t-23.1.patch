diff --git a/lk2nd/device/dts/msm8909/msm8909-hisense-m20t.dts b/lk2nd/device/dts/msm8909/msm8909-hisense-m20t.dts
new file mode 100644
index 00000000..ff09eb4b
--- /dev/null
+++ b/lk2nd/device/dts/msm8909/msm8909-hisense-m20t.dts
@@ -0,0 +1,21 @@
+// SPDX-License-Identifier: BSD-3-Clause
+
+#include <skeleton32.dtsi>
+#include <lk2nd.dtsi>
+
+/ {
+	qcom,msm-id = <QCOM_ID_MSM8909 0>;
+	/*
+	 * Hisense M20-T reports the QRD board id (0xf5 / 0x1000b) with subtype 0.
+	 * The stock QCDT table only carries subtype 8 for this board id, hence the
+	 * single-byte QCDT patch that made the original lk2nd image boot here.
+	 */
+	qcom,board-id = <QCOM_BOARD_ID(QRD, 0x01, 0) 0x0>;
+};
+
+&lk2nd {
+	hisense-m20t {
+		model = "Hisense M20-T";
+		compatible = "hisense,m20t";
+	};
+};
