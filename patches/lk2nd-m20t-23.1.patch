diff --git a/lk2nd/include/lk2nd/m20t.h b/lk2nd/include/lk2nd/m20t.h
new file mode 100644
index 0000000..30a901a
--- /dev/null
+++ b/lk2nd/include/lk2nd/m20t.h
@@ -0,0 +1,39 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/* Hisense M20-T boot control.
+ *
+ * Targets: LINUX  = second-stage slot, boot attempts counted, falls back to
+ *                    fastboot after repeated failures (mainline test slot).
+ *          ANDROID = second-stage slot without counting (daily driver).
+ *          FASTBOOT = stop in fastboot.
+ * The recovery partition keeps the stock recovery image; boot_into_recovery
+ * (menu/misc) boots it in recovery mode. */
+
+
+#ifndef LK2ND_M20T_H
+#define LK2ND_M20T_H
+
+#include <sys/types.h>
+
+#define M20T_TARGET_LINUX	0
+#define M20T_TARGET_ANDROID	1
+#define M20T_TARGET_FASTBOOT	2
+
+/* Called at normal_boot: applies the stored default target and falls back to
+ * fastboot once the Linux slot exhausted its boot attempts. */
+void m20t_preboot(void);
+
+/* Count one more Linux boot attempt (no-op unless Linux is the default). */
+void m20t_count_attempt(void);
+
+/* Clear the attempt counter (entering fastboot, Android reached, image flashed). */
+void m20t_reset_attempts(void);
+
+/* Persist the default boot target. Returns true on success. */
+bool m20t_set_default(uint8_t target);
+
+/* Hook for fastboot flash: "boot" selects Linux, "recovery" leaves it alone. */
+void m20t_flash_hook(const char *pname);
+
+const char *m20t_target_name(uint8_t target);
+
+#endif /* LK2ND_M20T_H */
diff --git a/lk2nd/m20t/m20t.c b/lk2nd/m20t/m20t.c
new file mode 100644
index 0000000..35e3257
--- /dev/null
+++ b/lk2nd/m20t/m20t.c
@@ -0,0 +1,306 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Hisense M20-T boot control.
+ *
+ * Two jobs:
+ *  1. Allow "Android" as the default boot target. The stock Android boot image
+ *     lives in the "recovery" partition, the "boot" partition (+512 KiB after
+ *     lk2nd) is the Linux test slot.
+ *  2. Count Linux boot attempts in the last usable sector region of the "boot"
+ *     partition. If the Linux image hangs, the watchdog resets the SoC, lk2nd
+ *     runs again, sees attempts >= max and stops in fastboot instead of looping
+ *     forever. The initramfs clears the counter once userspace is reachable.
+ *
+ * State block: LAST sector of the boot partition, one 512-byte sector. Anything that
+ * rewrites the whole boot partition (EDL restore) resets it to defaults, which
+ * is exactly the desired behaviour.
+ */
+
+#include <compiler.h>
+#include <debug.h>
+#include <fastboot.h>
+#include <mmc.h>
+#include <partition_parser.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include <lk2nd/m20t.h>
+
+extern bool boot_into_fastboot;
+extern unsigned boot_into_recovery;
+
+#define M20T_STATE_MAGIC	0x4d323054u	/* "M20T" */
+#define M20T_STATE_SIZE		512u
+#define M20T_DEFAULT_ATTEMPTS	2u
+#define M20T_ATTEMPT_CAP	254u
+
+struct m20t_state {
+	uint32_t magic;
+	uint8_t attempts;
+	uint8_t max_attempts;
+	uint8_t def_target;
+	uint8_t rsvd;
+	uint32_t inv_magic;
+} __attribute__((packed));
+
+static uint8_t m20t_sector[M20T_STATE_SIZE] __attribute__((aligned(8)));
+static uint64_t m20t_addr;
+static bool m20t_ready;
+static bool m20t_checked;
+
+const char *m20t_target_name(uint8_t target)
+{
+	switch (target) {
+	case M20T_TARGET_ANDROID:
+		return "android";
+	case M20T_TARGET_FASTBOOT:
+		return "fastboot";
+	default:
+		return "linux";
+	}
+}
+
+static bool m20t_resolve(void)
+{
+	int index;
+
+	if (m20t_checked)
+		return m20t_ready;
+	m20t_checked = true;
+
+	/*
+	 * The GPT declares the boot partition 31 MiB (not 32) and lk2nd also
+	 * exposes a 512 KiB virtual "lk2nd" partition; both made the old fixed
+	 * 31 MiB state offset fail the size check (or land past the partition
+	 * end). Use the LAST sector of the real boot partition instead.
+	 */
+	index = partition_get_index("boot");
+	if (index == INVALID_PTN)
+		index = partition_get_index("lk2nd");
+	if (index == INVALID_PTN) {
+		dprintf(INFO, "M20T: no boot partition, boot control disabled\n");
+		return false;
+	}
+
+	if (partition_get_size(index) < 2u * 1024u * 1024u) {
+		dprintf(CRITICAL, "M20T: boot partition too small for state block\n");
+		return false;
+	}
+
+	mmc_set_lun(partition_get_lun(index));
+	m20t_addr = partition_get_offset(index) + partition_get_size(index)
+		    - M20T_STATE_SIZE;
+	m20t_ready = true;
+	return true;
+}
+
+/* Fill *s with the persisted state, or with defaults if it cannot be read. */
+static bool m20t_load(struct m20t_state *s)
+{
+	struct m20t_state def = {
+		.magic = M20T_STATE_MAGIC,
+		.attempts = 0,
+		.max_attempts = M20T_DEFAULT_ATTEMPTS,
+		.def_target = M20T_TARGET_LINUX,
+		.rsvd = 0,
+		.inv_magic = ~M20T_STATE_MAGIC,
+	};
+
+	*s = def;
+
+	if (!m20t_resolve())
+		return false;
+	if (mmc_read(m20t_addr, (uint32_t *)m20t_sector, M20T_STATE_SIZE))
+		return false;
+
+	memcpy(s, m20t_sector, sizeof(*s));
+	if (s->magic != M20T_STATE_MAGIC || s->inv_magic != ~M20T_STATE_MAGIC)
+		return false;
+	if (!s->max_attempts || s->max_attempts > M20T_ATTEMPT_CAP)
+		s->max_attempts = M20T_DEFAULT_ATTEMPTS;
+	if (s->def_target > M20T_TARGET_FASTBOOT)
+		s->def_target = M20T_TARGET_LINUX;
+	s->rsvd = 0;
+
+	return true;
+}
+
+static void m20t_store(const struct m20t_state *in)
+{
+	struct m20t_state s = *in;
+
+	if (!m20t_ready)
+		return;
+
+	s.magic = M20T_STATE_MAGIC;
+	s.inv_magic = ~M20T_STATE_MAGIC;
+	s.rsvd = 0;
+
+	memset(m20t_sector, 0, sizeof(m20t_sector));
+	memcpy(m20t_sector, &s, sizeof(s));
+	if (mmc_write(m20t_addr, M20T_STATE_SIZE, m20t_sector))
+		dprintf(CRITICAL, "M20T: failed to update state block\n");
+}
+
+void m20t_reset_attempts(void)
+{
+	struct m20t_state s;
+
+	m20t_load(&s);
+	if (!s.attempts)
+		return;
+	s.attempts = 0;
+	m20t_store(&s);
+}
+
+void m20t_count_attempt(void)
+{
+	struct m20t_state s;
+
+	m20t_load(&s);
+	if (s.def_target != M20T_TARGET_LINUX)
+		return;		/* daily-driver Android boots must not trip the fallback */
+	if (s.attempts >= M20T_ATTEMPT_CAP)
+		return;
+	s.attempts++;
+	m20t_store(&s);
+}
+
+bool m20t_set_default(uint8_t target)
+{
+	struct m20t_state s;
+
+	if (target > M20T_TARGET_FASTBOOT)
+		return false;
+
+	m20t_load(&s);
+	if (!m20t_ready)
+		return false;
+
+	s.def_target = target;
+	if (target != M20T_TARGET_LINUX)
+		s.attempts = 0;
+	m20t_store(&s);
+
+	dprintf(ALWAYS, "M20T: default boot target = %s\n", m20t_target_name(target));
+	return true;
+}
+
+void m20t_flash_hook(const char *pname)
+{
+	if (!pname || strcmp(pname, "boot"))
+		return;
+
+	/*
+	 * Flashing the Linux slot is an explicit "boot this next" request: make
+	 * sure a stale "android" default does not hide the freshly written image.
+	 */
+	m20t_set_default(M20T_TARGET_LINUX);
+	m20t_reset_attempts();
+}
+
+void m20t_preboot(void)
+{
+	struct m20t_state s;
+	bool persisted = m20t_load(&s);
+
+	/* Android recovery already requested (menu, misc command, key combo). */
+	if (boot_into_recovery) {
+		dprintf(ALWAYS, "M20T: booting Android (recovery partition)\n");
+		if (persisted && s.attempts) {
+			s.attempts = 0;
+			m20t_store(&s);
+		}
+		return;
+	}
+
+	if (s.attempts >= s.max_attempts) {
+		dprintf(ALWAYS, "M20T: %u/%u Linux boot attempts failed, "
+			"falling back to fastboot\n", s.attempts, s.max_attempts);
+		s.attempts = 0;
+		m20t_store(&s);
+		boot_into_fastboot = true;
+		return;
+	}
+
+	switch (s.def_target) {
+	case M20T_TARGET_ANDROID:
+		/*
+		 * Daily-driver Android: boot the second-stage slot like Linux
+		 * but WITHOUT attempt counting (no fastboot fallback).
+		 */
+		dprintf(ALWAYS, "M20T: default target android (second stage)\n");
+		if (persisted && s.attempts) {
+			s.attempts = 0;
+			m20t_store(&s);
+		}
+		return;
+	case M20T_TARGET_FASTBOOT:
+		dprintf(ALWAYS, "M20T: default target fastboot\n");
+		if (persisted && s.attempts) {
+			s.attempts = 0;
+			m20t_store(&s);
+		}
+		boot_into_fastboot = true;
+		return;
+	default:
+		break;
+	}
+
+	/* Linux: remember this attempt before handing over to the kernel. */
+	dprintf(ALWAYS, "M20T: Linux boot attempt %u/%u\n",
+		s.attempts + 1, s.max_attempts);
+	if (s.attempts < M20T_ATTEMPT_CAP) {
+		s.attempts++;
+		m20t_store(&s);
+	}
+}
+
+static void cmd_oem_m20t_state(const char *arg, void *data, unsigned sz)
+{
+	struct m20t_state s;
+	char reply[96];
+
+	m20t_load(&s);
+	snprintf(reply, sizeof(reply), "attempts=%u/%u default=%s",
+		 s.attempts, s.max_attempts, m20t_target_name(s.def_target));
+	fastboot_okay(reply);
+}
+
+static void cmd_oem_m20t_reset(const char *arg, void *data, unsigned sz)
+{
+	m20t_reset_attempts();
+	fastboot_okay("attempts cleared");
+}
+
+static void cmd_oem_m20t_default(const char *arg, void *data, unsigned sz)
+{
+	uint8_t target;
+
+	if (!arg || !arg[0]) {
+		fastboot_fail("usage: oem m20t-default <linux|android|fastboot>");
+		return;
+	}
+
+	if (!strcmp(arg, "linux"))
+		target = M20T_TARGET_LINUX;
+	else if (!strcmp(arg, "android"))
+		target = M20T_TARGET_ANDROID;
+	else if (!strcmp(arg, "fastboot"))
+		target = M20T_TARGET_FASTBOOT;
+	else {
+		fastboot_fail("unknown target (linux|android|fastboot)");
+		return;
+	}
+
+	if (!m20t_set_default(target)) {
+		fastboot_fail("state block unavailable");
+		return;
+	}
+
+	fastboot_okay(m20t_target_name(target));
+}
+
+FASTBOOT_REGISTER("oem m20t-state", cmd_oem_m20t_state);
+FASTBOOT_REGISTER("oem m20t-reset", cmd_oem_m20t_reset);
+FASTBOOT_REGISTER("oem m20t-default", cmd_oem_m20t_default);
