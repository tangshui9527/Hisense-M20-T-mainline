// SPDX-License-Identifier: GPL-2.0-only
/*
 * Hisense M20-T (Uniscope ODM, MSM8909 + PM8909).
 *
 * Headless port: no display/touch/audio/keypad -- the device serves as a
 * boot-and-serve mini rootfs host (Alpine armhf) with WiFi + SSH.
 *
 * Root node qcom,msm-id / qcom,board-id are copied verbatim from the stock
 * bootloader's DT blob (the entry the stock aboot actually selects for this
 * hardware: "MSM8909-PM8909 1GB QRD SKUA", soc_id=245/0xf5,
 * platform_version=0x10000, hw_platform=QRD, subtype=0), because the stock
 * aboot (not lk2nd) picks the DTB by matching these ids against SMEM values.
 *
 * USB controller is ci-hdrc; WiFi = wcn3620; PMIC = PM8909.
 */

/dts-v1/;

#include "qcom-msm8909-pm8909.dtsi"

#include <dt-bindings/gpio/gpio.h>

/ {
	model = "Hisense M20-T";
	compatible = "hisense,m20-t", "qcom,msm8909";
	chassis-type = "handset";

	/* Stock bootloader DT-matching ids (see comment above). */
	qcom,msm-id = <0xf5 0x0 0x102 0x0 0x109 0x0 0x113 0x0>;
	qcom,board-id = <0x1000b 0x0>;

	aliases {
		mmc0 = &sdhc_1;
		serial0 = &blsp_uart1;
	};

	chosen {
		stdout-path = "serial0";
	};

	/*
	 * MSM8909 Hisense M20-T Physical Memory Map:
	 * Verified directly from live Android 4.4 /proc/iomem and dtb17:
	 * Bank 0: 0x80000000 - 0x87afffff (123 MB System RAM)
	 * Ramoops: 0x87b00000 - 0x87bfffff (1 MB in Lowmem! 100% readable by /dev/mem!)
	 * Hole:   0x87c00000 - 0x8c5fffff (74 MB: TrustZone, Modem 65MB, Peripheral 5MB)
	 * Bank 1: 0x8c600000 - 0xbfffffff (826 MB System RAM)
	 *
	 * Both 'memory' and 'memory@80000000' are declared:
	 * 1) 'memory' (plain) satisfies lk2nd's fdt_path_offset("/memory")
	 * 2) 'memory@80000000' satisfies standard OF/FDT unit-address conventions.
	 */
	memory {
		device_type = "memory";
		reg = <0x80000000 0x07b00000>,
		      <0x8c600000 0x33a00000>;
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x07b00000>,
		      <0x8c600000 0x33a00000>;
	};

	reserved-memory {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		/* Ramoops / PStore in Lowmem (1MB at 0x87b00000) */
		ramoops: ramoops@87b00000 {
			compatible = "ramoops";
			reg = <0x87b00000 0x00100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
		};

		/* External image reserve (4MB) */
		external_image: extimg@87c00000 {
			reg = <0x87c00000 0x00400000>;
			no-map;
		};

		/* Modem/ADSP baseband firmware (65MB) - TrustZone XPU protected! */
		modem_adsp: modem@88000000 {
			reg = <0x88000000 0x04100000>;
			no-map;
		};

		/* Peripheral subsystem (5MB) - TrustZone protected! */
		peripheral: periph@8c100000 {
			reg = <0x8c100000 0x00500000>;
			no-map;
		};
	};

	battery: battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <3400000>;
		voltage-max-design-microvolt = <4350000>;
		energy-full-design-microwatt-hours = <7300000>;
		charge-full-design-microamp-hours = <2000000>;
	};
};

&blsp_uart1 {
	status = "okay";
};

&pm8909_bms {
	monitored-battery = <&battery>;
	power-supplies = <&pm8909_charger>;
	status = "okay";
};

&pm8909_charger {
	qcom,vdd-safe = <4400000>;
	qcom,ibat-safe = <360000>;

	monitored-battery = <&battery>;

	status = "okay";
};

&pm8909_usbin {
	status = "okay";
};

&sdhc_1 {
	/delete-property/ mmc-hs200-1_8v;
	/delete-property/ mmc-ddr-1_8v;
	no-1-8-v;
	cap-mmc-highspeed;
	status = "okay";
};

&sdhc_2 {
	status = "disabled";
};

&usb {
	extcon = <&pm8909_usbin>;
	dr_mode = "peripheral";
	status = "okay";
};

&usb_hs_phy {
	v1p8-supply = <&pm8909_l7>;
	v3p3-supply = <&pm8909_l13>;
	extcon = <&pm8909_usbin>;
};

&wcnss {
	status = "okay";
};

&wcnss_iris {
	compatible = "qcom,wcn3620";
};

&smd_rpm_regulators {
	l5 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	l7 {
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
	};

	l8 {
		regulator-min-microvolt = <2850000>;
		regulator-max-microvolt = <2900000>;
	};

	l13 {
		regulator-min-microvolt = <3075000>;
		regulator-max-microvolt = <3075000>;
	};
};
