			dmas = <0x49 0x0c 0x49 0x0d>;
			dma-names = "tx", "rx";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0x5c>;
			pinctrl-1 = <0x5d>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		i2c@78ba000 {
			compatible = "qcom,i2c-qup-v2.2.1";
			reg = <0x78ba000 0x500>;
			interrupts = <0x00 0x64 0x04>;
			clocks = <0x14 0x54 0x14 0x3a>;
			clock-names = "core", "iface";
			dmas = <0x49 0x0e 0x49 0x0f>;
			dma-names = "tx", "rx";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0x5e>;
			pinctrl-1 = <0x5f>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		spi@78ba000 {
			compatible = "qcom,spi-qup-v2.2.1";
			reg = <0x78ba000 0x500>;
			interrupts = <0x00 0x64 0x04>;
			clocks = <0x14 0x55 0x14 0x3a>;
			clock-names = "core", "iface";
			dmas = <0x49 0x0e 0x49 0x0f>;
			dma-names = "tx", "rx";
			pinctrl-names = "default", "sleep";
			pinctrl-0 = <0x60>;
			pinctrl-1 = <0x61>;
			#address-cells = <0x01>;
			#size-cells = <0x00>;
			status = "disabled";
		};

		usb@78d9000 {
			compatible = "qcom,ci-hdrc";
			reg = <0x78d9000 0x200 0x78d9200 0x200>;
			interrupts = <0x00 0x86 0x04 0x00 0x8c 0x04>;
			clocks = <0x14 0x8d 0x14 0x8f>;
			clock-names = "iface", "core";
			assigned-clocks = <0x14 0x8f>;
			assigned-clock-rates = <0x4c4b400>;
			resets = <0x14 0x27>;
			reset-names = "core";
			phy_type = "ulpi";
			dr_mode = "otg";
			hnp-disable;
			srp-disable;
			adp-disable;
			ahb-burst-config = <0x00>;
			phy-names = "usb-phy";
			phys = <0x62>;
			status = "okay";
			#reset-cells = <0x01>;
			usb-role-switch;

			ulpi {

				phy {
					compatible = "qcom,usb-hs-phy-msm8909", "qcom,usb-hs-phy";
					#phy-cells = <0x00>;
					clocks = <0x18 0x14 0x8c>;
					clock-names = "ref", "sleep";
					resets = <0x14 0x21 0x14 0x26>;
					reset-names = "phy", "por";
					qcom,init-seq = <0x16031703>;
					v1p8-supply = <0x2f>;
					v3p3-supply = <0x64>;
					phandle = <0x62>;
				};
			};
		};

		sram@8600000 {
			compatible = "qcom,msm8909-imem", "syscon", "simple-mfd";
			reg = <0x8600000 0x1000>;
			ranges = <0x00 0x8600000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x65c>;
				mode-bootloader = "wfU";
				mode-normal = <0x77665501>;
				mode-recovery = <0x77665502>;
			};
		};

		remoteproc@a21b000 {
			compatible = "qcom,pronto-v3-pil", "qcom,pronto";
			reg = <0xa204000 0x2000 0xa202000 0x1000 0xa21b000 0x3000>;
			reg-names = "ccu", "dxe", "pmu";
			memory-region = <0x65>;
			interrupts-extended = <0x01 0x00 0x95 0x01 0x66 0x00 0x01 0x66 0x01 0x01 0x66 0x02 0x01 0x66 0x03 0x01>;
			interrupt-names = "wdog", "fatal", "ready", "handover", "stop-ack";
			power-domains = <0x04 0x00 0x04 0x03>;
			power-domain-names = "cx", "mx";
			qcom,smem-states = <0x67 0x00>;
			qcom,smem-state-names = "stop";
			pinctrl-names = "default";
			pinctrl-0 = <0x68>;
			status = "okay";
			vddpx-supply = <0x2f>;
			phandle = <0x6c>;

			iris {
				clocks = <0x69 0x10>;
				clock-names = "xo";
				vddxo-supply = <0x2f>;
				vddrfa-supply = <0x6a>;
				vddpa-supply = <0x6b>;
				vdddig-supply = <0x3c>;
				compatible = "qcom,wcn3620";
				status = "okay";
			};

			smd-edge {
				interrupts = <0x00 0x8e 0x01>;
				qcom,ipc = <0x03 0x08 0x11>;
				qcom,smd-edge = <0x06>;
				qcom,remote-pid = <0x04>;
				label = "pronto";

				wcnss {
					compatible = "qcom,wcnss";
					qcom,smd-channels = "WCNSS_CTRL";
					qcom,mmio = <0x6c>;

					bluetooth {
						compatible = "qcom,wcnss-bt";
						local-bd-address = [9d 33 2f f5 0a 00];
						status = "okay";
					};

					wifi {
						compatible = "qcom,wcnss-wlan";
						interrupts = <0x00 0x91 0x04 0x00 0x92 0x04>;
						interrupt-names = "tx", "rx";
						qcom,smem-states = <0x33 0x0a 0x33 0x09>;
						qcom,smem-state-names = "tx-enable", "tx-rings-empty";
					};
				};
			};
		};

		interrupt-controller@b000000 {
			compatible = "qcom,msm-qgic2";
			reg = <0xb000000 0x1000 0xb002000 0x1000>;
			interrupt-controller;
			#interrupt-cells = <0x03>;
			phandle = <0x01>;
		};

		mailbox@b011000 {
			compatible = "qcom,msm8916-apcs-kpss-global", "syscon";
			reg = <0xb011000 0x1000>;
			#mbox-cells = <0x01>;
			clocks = <0x6d 0x14 0x01>;
			clock-names = "pll", "aux";
			#clock-cells = <0x00>;
			phandle = <0x03>;
		};

		clock@b016000 {
			compatible = "qcom,msm8916-a53pll";
			reg = <0xb016000 0x40>;
			#clock-cells = <0x00>;
			clocks = <0x18>;
			clock-names = "xo";
			operating-points-v2 = <0x6e>;
			phandle = <0x6d>;

			opp-table {
				compatible = "operating-points-v2";
				phandle = <0x6e>;

				opp-998400000 {
					opp-hz = <0x00 0x3b826000>;
				};

				opp-1094400000 {
					opp-hz = <0x00 0x413b3800>;
				};

				opp-1190400000 {
					opp-hz = <0x00 0x46f41000>;
				};

				opp-1248000000 {
					opp-hz = <0x00 0x4a62f800>;
				};

				opp-1267200000 {
					opp-hz = <0x00 0x4b87f000>;
				};
			};
		};

		timer@b020000 {
			compatible = "arm,armv7-timer-mem";
			reg = <0xb020000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			ranges;

			frame@b021000 {
				reg = <0xb021000 0x1000 0xb022000 0x1000>;
				interrupts = <0x00 0x08 0x04 0x00 0x07 0x04>;
				frame-number = <0x00>;
			};

			frame@b023000 {
				reg = <0xb023000 0x1000>;
				interrupts = <0x00 0x09 0x04>;
				frame-number = <0x01>;
				status = "disabled";
			};

			frame@b024000 {
				reg = <0xb024000 0x1000>;
				interrupts = <0x00 0x0a 0x04>;
				frame-number = <0x02>;
				status = "disabled";
			};

			frame@b025000 {
				reg = <0xb025000 0x1000>;
				interrupts = <0x00 0x0b 0x04>;
				frame-number = <0x03>;
				status = "disabled";
			};

			frame@b026000 {
				reg = <0xb026000 0x1000>;
				interrupts = <0x00 0x0c 0x04>;
				frame-number = <0x04>;
				status = "disabled";
			};

			frame@b027000 {
				reg = <0xb027000 0x1000>;
				interrupts = <0x00 0x0d 0x04>;
				frame-number = <0x05>;
				status = "disabled";
			};

			frame@b028000 {
				reg = <0xb028000 0x1000>;
				interrupts = <0x00 0x0e 0x04>;
				frame-number = <0x06>;
				status = "disabled";
			};
		};

		power-manager@b088000 {
			compatible = "qcom,msm8909-acc";
			reg = <0xb088000 0x1000>;
			phandle = <0x07>;
		};

		power-manager@b089000 {
			compatible = "qcom,msm8909-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb089000 0x1000>;
			phandle = <0x08>;
		};

		power-manager@b098000 {
			compatible = "qcom,msm8909-acc";
			reg = <0xb098000 0x1000>;
			phandle = <0x09>;
		};

		power-manager@b099000 {
			compatible = "qcom,msm8909-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb099000 0x1000>;
			phandle = <0x0a>;
		};

		power-manager@b0a8000 {
			compatible = "qcom,msm8909-acc";
			reg = <0xb0a8000 0x1000>;
			phandle = <0x0b>;
		};

		power-manager@b0a9000 {
			compatible = "qcom,msm8909-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb0a9000 0x1000>;
			phandle = <0x0c>;
		};

		power-manager@b0b8000 {
			compatible = "qcom,msm8909-acc";
			reg = <0xb0b8000 0x1000>;
			phandle = <0x0d>;
		};

		power-manager@b0b9000 {
			compatible = "qcom,msm8909-saw2-v3.0-cpu", "qcom,saw2";
			reg = <0xb0b9000 0x1000>;
			phandle = <0x0e>;
		};
	};

	thermal-zones {

		cpu0-2-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x03>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x70>;
				};

				cpu_crit {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x70>;
					cooling-device = <0x71 0xffffffff 0xffffffff 0x72 0xffffffff 0xffffffff 0x73 0xffffffff 0xffffffff 0x74 0xffffffff 0xffffffff>;
				};
			};
		};

		cpu1-3-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x04>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "passive";
					phandle = <0x75>;
				};

				cpu_crit {
					temperature = <0x186a0>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};

			cooling-maps {

				map0 {
					trip = <0x75>;
					cooling-device = <0x71 0xffffffff 0xffffffff 0x72 0xffffffff 0xffffffff 0x73 0xffffffff 0xffffffff 0x74 0xffffffff 0xffffffff>;
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x02>;

			trips {

				trip-point0 {
					temperature = <0x15f90>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};

		camera-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x01>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};

		modem-thermal {
			polling-delay-passive = <0xfa>;
			polling-delay = <0x00>;
			thermal-sensors = <0x6f 0x00>;

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x7d0>;
					type = "hot";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv7-timer";
		interrupts = <0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x04 0xf08 0x01 0x01 0xf08>;
	};

	memory {
		device_type = "memory";
		reg = <0x80000000 0x7a00000 0x8c600000 0x33a00000>;
	};

	battery {
		compatible = "simple-battery";
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x426030>;
		energy-full-design-microwatt-hours = <0x6f63a0>;
		charge-full-design-microamp-hours = <0x1e8480>;
		phandle = <0x29>;
	};
};

/* Volume-up key: GPIO 90 (from the stock dtb17 gpio_keys/vol_up node,
 * active-low, KEY_VOLUMEUP). The power key on this unit is broken. */
gpio-keys {
	compatible = "gpio-keys";
	label = "volume_up";

	vol_up {
		label = "volume_up";
		gpios = <&tlmm 90 1>;
		linux,input-type = <1>;
		linux,code = <115>;
		debounce-interval = <15>;
	};
};
