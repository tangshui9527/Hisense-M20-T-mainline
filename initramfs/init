#!/busybox sh
# initramfs /init for m20-t-mainline -- RAM-root rescue/control stage.
# Exposes CDC-ACM USB Serial Console (/dev/ttyGS0 -> macOS /dev/cu.usbmodem*)

export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Install busybox applets into /bin and /sbin
/busybox --install -s /bin 2>/dev/null
/busybox --install -s /sbin 2>/dev/null

# Basic virtual filesystems
mkdir -p /proc /sys /dev /tmp /config /dev/pts /run /bin /sbin
busybox mount -t proc     none /proc     2>/dev/null || true
busybox mount -t sysfs    none /sys      2>/dev/null || true
busybox mount -t devtmpfs none /dev      2>/dev/null || true
busybox mount -t devpts   none /dev/pts  2>/dev/null || true
busybox mount -t tmpfs    none /tmp      2>/dev/null || true
busybox mount -t configfs none /config   2>/dev/null || true
busybox mdev -s 2>/dev/null || true

LOG=/tmp/boot.log
klog() {
    echo "<1>M20T: $*" > /dev/kmsg 2>/dev/null
    echo "$*" >> "$LOG"
}

klog "initramfs started on $(uname -a)"

# --- Clear lk2nd boot-failure marker on eMMC boot partition ---
clear_lk2nd_attempts() {
    for uevent in /sys/class/block/mmcblk0p*/uevent; do
        [ -e "$uevent" ] || continue
        grep -q '^PARTNAME=boot$' "$uevent" || continue
        blk="/dev/$(basename "$(dirname "$uevent")")"
        [ -b "$blk" ] || continue
        if busybox dd if=/dev/zero of="$blk" bs=1 seek=32505860 count=1 conv=notrunc 2>/dev/null; then
            klog "lk2nd boot attempt counter cleared on $blk"
        fi
        return 0
    done
    return 0
}
clear_lk2nd_attempts

# --- USB Gadget Handler ---
# Check if g_serial (built-in) is active
UDC=$(ls /sys/class/udc 2>/dev/null | busybox head -n 1)
klog "Detected UDC: ${UDC:-none}"

if [ -f /sys/class/tty/ttyGS0/dev ] || [ -c /dev/ttyGS0 ]; then
    klog "Native g_serial detected on /dev/ttyGS0"
else
    # Try configfs fallback if g_serial didn't bind
    klog "Attempting configfs gadget setup..."
    mkdir -p /config/usb_gadget/g1 2>/dev/null
    if [ -d /config/usb_gadget/g1 ]; then
        cd /config/usb_gadget/g1
        echo 0x18d1 > idVendor 2>/dev/null
        echo 0x4ee7 > idProduct 2>/dev/null
        mkdir -p strings/0x409 2>/dev/null
        echo "Hisense" > strings/0x409/manufacturer 2>/dev/null
        echo "M20-T Mainline" > strings/0x409/product 2>/dev/null
        echo "2f339cef" > strings/0x409/serialnumber 2>/dev/null
        mkdir -p functions/acm.usb0 2>/dev/null
        mkdir -p configs/c.1/strings/0x409 2>/dev/null
        ln -sf functions/acm.usb0 configs/c.1/acm 2>/dev/null
        if [ -n "$UDC" ]; then
            echo "$UDC" > UDC 2>/dev/null && klog "Configfs bound to $UDC"
        fi
    fi
fi

# Ensure device node /dev/ttyGS0 exists
if [ ! -c /dev/ttyGS0 ] && [ -f /sys/class/tty/ttyGS0/dev ]; then
    IFS=: read -r maj min < /sys/class/tty/ttyGS0/dev
    busybox mknod /dev/ttyGS0 c "$maj" "$min" 2>/dev/null
fi

# Background task: Monitor /dev/ttyGS0 and spawn root shell
(
    while true; do
        if [ ! -c /dev/ttyGS0 ] && [ -f /sys/class/tty/ttyGS0/dev ]; then
            IFS=: read -r maj min < /sys/class/tty/ttyGS0/dev
            busybox mknod /dev/ttyGS0 c "$maj" "$min" 2>/dev/null
        fi
        if [ -c /dev/ttyGS0 ]; then
            klog "Spawning interactive root shell on /dev/ttyGS0..."
            /busybox setsid /bin/sh </dev/ttyGS0 >/dev/ttyGS0 2>&1
        fi
        sleep 1
    done
) &

# Telnet daemon on port 23 if network is ever configured
busybox telnetd -l /bin/sh 2>/dev/null || true

klog "initramfs initialization complete. PID 1 entering sleep loop."

# PID 1 must never exit!
while true; do
    sleep 3600
done
