/dts-v1/;

/ {
	#address-cells = <0x01>;
	#size-cells = <0x01>;
	interrupt-parent = <0x01>;
	model = "Hisense M20-T";
	compatible = "hisense,m20-t", "qcom,msm8909";
	chassis-type = "handset";
	qcom,msm-id = <0xf5 0x00 0x102 0x00 0x109 0x00 0x113 0x00>;
	qcom,board-id = <0x1000b 0x00>;

	aliases {
		mmc0 = "/soc@0/sdhci@7824000";
		mmc1 = "/soc@0/sdhci@7864000";
		serial0 = "/soc@0/serial@78af000";
	};

	chosen {
		linux,initrd-end = <0x82159dd5>;
		linux,initrd-start = <0x82000000>;
		stdout-path = "serial0";
		bootargs = "console=tty0 console=ttyMSM0,115200,n8 lk2nd.pass-simplefb lk2nd.pass-ramoops earlycon panic=0 console=ttyMSM0,115200,n8 panic=10 sdhci.debug_quirks2=0x200 androidboot.emmc=true androidboot.serialno=2f339cef androidboot.mode=charger androidboot.baseband=msm mdss_mdp3.panel=1:dsi:0:qcom,mdss_dsi_ili9806e_cpt_fwvga_video:1:none";
	};

	clocks {

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			phandle = <0x18>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x8000>;
			phandle = <0x28>;
		};
	};

	cpus {
		#address-cells = <0x01>;
		#size-cells = <0x00>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x00>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x07>;
			qcom,saw = <0x08>;
			phandle = <0x71>;
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x01>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x09>;
			qcom,saw = <0x0a>;
			phandle = <0x72>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x02>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x0b>;
			qcom,saw = <0x0c>;
			phandle = <0x73>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x03>;
			next-level-cache = <0x02>;
			enable-method = "qcom,msm8909-smp";
			clocks = <0x03>;
			#cooling-cells = <0x02>;
			power-domains = <0x04 0x01>;
			power-domain-names = "perf";
			operating-points-v2 = <0x05>;
			cpu-idle-states = <0x06>;
			qcom,acc = <0x0d>;
			qcom,saw = <0x0e>;
			phandle = <0x74>;
		};

		l2-cache {
			compatible = "cache";
			cache-level = <0x02>;
			phandle = <0x02>;
		};

		idle-states {

			cpu-sleep-0 {
				compatible = "qcom,idle-state-spc";
				idle-state-name = "standalone-power-collapse";
				entry-latency-us = <0xb4>;
				exit-latency-us = <0xf0>;
				min-residency-us = <0x4ec>;
				local-timer-stop;
				phandle = <0x06>;
			};
		};
	};

	cpu-opp-table {
		compatible = "operating-points-v2-kryo-cpu", "operating-points-v2";
		nvmem-cells = <0x0f>;
		opp-shared;
		phandle = <0x05>;

		opp-199999951 {
			opp-hz = <0x00 0xbebc1cf>;
			required-opps = <0x10>;
			opp-supported-hw = <0xff>;
		};

		opp-399999902 {
			opp-hz = <0x00 0x17d7839e>;
			required-opps = <0x11>;
			opp-supported-hw = <0xff>;
		};

		opp-533333202 {
			opp-hz = <0x00 0x1fca04d2>;
			required-opps = <0x11>;
			opp-supported-hw = <0xff>;
		};

		opp-799999804 {
			opp-hz = <0x00 0x2faf073c>;
			required-opps = <0x12>;
			opp-supported-hw = <0xff>;
		};

		opp-998400000 {
			opp-hz = <0x00 0x3b826000>;
			required-opps = <0x12>;
			opp-supported-hw = <0x05>;
		};

		opp-1094400000 {
			opp-hz = <0x00 0x413b3800>;
			required-opps = <0x13>;
			opp-supported-hw = <0x05>;
		};

		opp-1248000000 {
			opp-hz = <0x00 0x4a62f800>;
			required-opps = <0x13>;
			opp-supported-hw = <0x01>;
		};

		opp-1267200000 {
			opp-hz = <0x00 0x4b87f000>;
			required-opps = <0x13>;
			opp-supported-hw = <0x01>;
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-msm8916", "qcom,scm";
			clocks = <0x14 0x3d 0x14 0x3f 0x14 0x3e>;
			clock-names = "core", "bus", "iface";
			qcom,dload-mode = <0x15 0x6100>;
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x80000000 0x40000000>;
	};

	pmu {
		compatible = "arm,cortex-a7-pmu";
		interrupts = <0x01 0x07 0xf04>;
	};

	reserved-memory {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		tz-apps@87a00000 {
			reg = <0x87a00000 0x200000>;
			no-map;
		};

		rmtfs@87c00000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x87c00000 0xe0000>;
			no-map;
			qcom,client-id = <0x01>;
		};

		rfsa@87ce0000 {
			reg = <0x87ce0000 0x20000>;
			no-map;
		};

		smem@87d00000 {
			compatible = "qcom,smem";
			reg = <0x87d00000 0x100000>;
			no-map;
			hwlocks = <0x16 0x03>;
			qcom,rpm-msg-ram = <0x17>;
		};

		tz@87e00000 {
			reg = <0x87e00000 0x200000>;
			no-map;
		};

		mpss@88000000 {
			reg = <0x88000000 0x5500000>;
			no-map;
			phandle = <0x31>;
		};

		wcnss@8d500000 {
			reg = <0x8d500000 0x700000>;
			no-map;
			phandle = <0x65>;
		};

		mba@8dc00000 {
			reg = <0x8dc00000 0x100000>;
			no-map;
			phandle = <0x30>;
		};

		ramoops@87900000 {
			compatible = "ramoops";
			reg = <0x87900000 0x100000>;
			record-size = <0x20000>;
			console-size = <0x40000>;
			pmsg-size = <0x20000>;
		};

		periph@8c100000 {
			reg = <0x8c100000 0x500000>;
			no-map;
		};
	};

	smd {
		compatible = "qcom,smd";

		rpm {
			interrupts = <0x00 0xa8 0x01>;
			qcom,ipc = <0x03 0x08 0x00>;
			qcom,smd-edge = <0x0f>;

			rpm-requests {
				compatible = "qcom,rpm-msm8909";
				qcom,smd-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-msm8909", "qcom,rpmcc";
					#clock-cells = <0x01>;
					clocks = <0x18>;
					clock-names = "xo";
					phandle = <0x69>;
				};

				power-controller {
					compatible = "qcom,msm8909-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x19>;
					phandle = <0x04>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x19>;

						opp1 {
							opp-level = <0x01>;
							phandle = <0x10>;
						};

						opp2 {
							opp-level = <0x02>;
						};

						opp3 {
							opp-level = <0x03>;
							phandle = <0x11>;
						};

						opp4 {
							opp-level = <0x04>;
							phandle = <0x12>;
						};

						opp5 {
							opp-level = <0x05>;
						};

						opp6 {
							opp-level = <0x06>;
							phandle = <0x13>;
						};
					};
				};

				pm8909-regulators {
					compatible = "qcom,rpm-pm8909-regulators";

					s2 {
					};

					l1 {
					};

					l2 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						regulator-always-on;
						regulator-boot-on;
					};

					l4 {
					};

					l5 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						phandle = <0x3c>;
					};

					l6 {
					};

					l7 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1b7740>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x2f>;
					};

					l8 {
						regulator-min-microvolt = <0x2b7cd0>;
						regulator-max-microvolt = <0x2c4020>;
						phandle = <0x3b>;
					};

					l9 {
						phandle = <0x6b>;
					};

					l10 {
						phandle = <0x6a>;
					};

					l11 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-allow-set-load;
						phandle = <0x43>;
					};

					l12 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x2d0370>;
						regulator-allow-set-load;
						phandle = <0x44>;
					};

					l13 {
						regulator-min-microvolt = <0x2e8970>;
						regulator-max-microvolt = <0x325aa0>;
						regulator-always-on;
						regulator-boot-on;
						phandle = <0x64>;
					};

					l14 {
					};

					l15 {
					};

					l17 {
					};

					l18 {
					};
				};
			};
		};
	};

	smp2p-hexagon {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupts = <0x00 0x1b 0x01>;
		qcom,ipc = <0x03 0x08 0x0e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x2e>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x2d>;
		};
	};

	smp2p-wcnss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1c3 0x1af>;
		interrupts = <0x00 0x8f 0x01>;
		qcom,ipc = <0x03 0x08 0x12>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x04>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x67>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x66>;
		};
	};

	smsm {
		compatible = "qcom,smsm";
		#address-cells = <0x01>;
		#size-cells = <0x00>;
		qcom,ipc-1 = <0x03 0x08 0x0d>;
		qcom,ipc-3 = <0x03 0x08 0x13>;

		apps@0 {
			reg = <0x00>;
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x33>;
		};

		hexagon@1 {
			reg = <0x01>;
			interrupts = <0x00 0x1a 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x32>;
		};

		wcnss@6 {
			reg = <0x06>;
			interrupts = <0x00 0x90 0x01>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
		};
	};

	soc@0 {
		compatible = "simple-bus";
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges;

		rng@22000 {
			compatible = "qcom,prng";
			reg = <0x22000 0x200>;
			clocks = <0x14 0x44>;
			clock-names = "core";
		};

		qfprom@5c000 {
			compatible = "qcom,qfprom";
			reg = <0x5c000 0x1000>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			speedbin@c {
				reg = <0x0c 0x01>;
				bits = <0x02 0x03>;
				phandle = <0x0f>;
			};

			s0-p1@a0 {
				reg = <0xa0 0x01>;
				bits = <0x00 0x06>;
				phandle = <0x1d>;
			};

			s0-p2@a0 {
				reg = <0xa0 0x02>;
				bits = <0x06 0x06>;
				phandle = <0x1e>;
			};

			s1-p1@a1 {
				reg = <0xa1 0x02>;
				bits = <0x04 0x06>;
				phandle = <0x1f>;
			};

			s1-p2@a2 {
				reg = <0xa2 0x01>;
				bits = <0x02 0x06>;
				phandle = <0x20>;
			};

			s2-p1@a3 {
				reg = <0xa3 0x01>;
				bits = <0x00 0x06>;
				phandle = <0x21>;
			};

			s2-p2@a3 {
				reg = <0xa3 0x02>;
				bits = <0x06 0x06>;
				phandle = <0x22>;
			};

			s3-p1@a4 {
				reg = <0xa4 0x02>;
				bits = <0x04 0x06>;
				phandle = <0x23>;
			};

			s3-p2@a5 {
				reg = <0xa5 0x01>;
				bits = <0x02 0x06>;
				phandle = <0x24>;
			};

			s4-p1@a6 {
				reg = <0xa6 0x01>;
				bits = <0x00 0x06>;
				phandle = <0x25>;
			};

			s4-p2@a6 {
				reg = <0xa6 0x02>;
				bits = <0x06 0x06>;
				phandle = <0x26>;
			};

			base1@dc {
				reg = <0xdc 0x01>;
				bits = <0x00 0x08>;
				phandle = <0x1b>;
			};

			base2@dd {
				reg = <0xdd 0x01>;
				bits = <0x00 0x08>;
				phandle = <0x1c>;
			};

			mode@de {
				reg = <0xde 0x01>;
				bits = <0x00 0x03>;
				phandle = <0x1a>;
			};
		};

		sram@60000 {
			compatible = "qcom,rpm-msg-ram";
			reg = <0x60000 0x8000>;
			phandle = <0x17>;
		};

		sram@290000 {
			compatible = "qcom,rpm-stats";
			reg = <0x290000 0x10000>;
		};

		thermal-sensor@4a9000 {
			compatible = "qcom,msm8909-tsens", "qcom,tsens-v0_1";
			reg = <0x4a9000 0x1000 0x4a8000 0x1000>;
			nvmem-cells = <0x1a 0x1b 0x1c 0x1d 0x1e 0x1f 0x20 0x21 0x22 0x23 0x24 0x25 0x26>;
			nvmem-cell-names = "mode", "base1", "base2", "s0_p1", "s0_p2", "s1_p1", "s1_p2", "s2_p1", "s2_p2", "s3_p1", "s3_p2", "s4_p1", "s4_p2";
			interrupts = <0x00 0xb8 0x04>;
			interrupt-names = "uplow";
			#thermal-sensor-cells = <0x01>;
			#qcom,sensors = <0x05>;
			phandle = <0x6f>;
		};

		restart@4ab000 {
			compatible = "qcom,pshold";
			reg = <0x4ab000 0x04>;
		};

		pinctrl@1000000 {
			compatible = "qcom,msm8909-tlmm";
			reg = <0x1000000 0x300000>;
			interrupts = <0x00 0xd0 0x04>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x27 0x00 0x00 0x75>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x27>;

			blsp-i2c1-default-state {
				pins = "gpio6", "gpio7";
				function = "blsp_i2c1";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x4a>;
			};

			blsp-i2c1-sleep-state {
				pins = "gpio6", "gpio7";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x4b>;
			};

			blsp-i2c2-default-state {
				pins = "gpio111", "gpio112";
				function = "blsp_i2c2";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x4e>;
			};

			blsp-i2c2-sleep-state {
				pins = "gpio111", "gpio112";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x4f>;
			};

			blsp-i2c3-default-state {
				pins = "gpio29", "gpio30";
				function = "blsp_i2c3";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x52>;
			};

			blsp-i2c3-sleep-state {
				pins = "gpio29", "gpio30";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x53>;
			};

			blsp-i2c4-default-state {
				pins = "gpio14", "gpio15";
				function = "blsp_i2c4";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x56>;
			};

			blsp-i2c4-sleep-state {
				pins = "gpio14", "gpio15";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x57>;
			};

			blsp-i2c5-default-state {
				pins = "gpio18", "gpio19";
				function = "blsp_i2c5";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x5a>;
			};

			blsp-i2c5-sleep-state {
				pins = "gpio18", "gpio19";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x5b>;
			};

			blsp-i2c6-default-state {
				pins = "gpio10", "gpio11";
				function = "blsp_i2c6";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x5e>;
			};

			blsp-i2c6-sleep-state {
				pins = "gpio10", "gpio11";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x5f>;
			};

			blsp-spi1-default-state {
				pins = "gpio4", "gpio5", "gpio6", "gpio7";
				function = "blsp_spi1";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x4c>;
			};

			blsp-spi1-sleep-state {
				pins = "gpio4", "gpio5", "gpio6", "gpio7";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x4d>;
			};

			blsp-spi2-default-state {
				pins = "gpio20", "gpio21", "gpio111", "gpio112";
				function = "blsp_spi2";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x50>;
			};

			blsp-spi2-sleep-state {
				pins = "gpio20", "gpio21", "gpio111", "gpio112";
				function = "gpio";
				drive-strength = <0x02>;
				bias-pull-down;
				phandle = <0x51>;
			};

			blsp-spi3-default-state {
				pins = "gpio0", "gpio1", "gpio2", "gpio3";
				function = "blsp_spi3";
				drive-strength = <0x0c>;
				bias-disable;
				phandle = <0x54>;
			};

			blsp-spi3-sleep-state {
