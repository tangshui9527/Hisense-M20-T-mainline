#!/bin/sh
BASE=/opt/usb-role-manager
LOCK=/tmp/usb-role.lock
STATE=$BASE/state
exec 9>$LOCK
flock 9
RS=/sys/class/usb_role/ci_hdrc.0-role-switch/role
[ -w $RS ] || exit 0
mode=$(cat $STATE/mode 2>/dev/null || echo auto)
now=$(date +%s)
if [ "$mode" = "manual" ]; then
    expires=$(cat $STATE/expires 2>/dev/null || echo 0)
    [ $now -lt $expires ] && exit 0      # 手动模式未到期，不动
    # 到期：清手动标记，落到调度
    echo "$(date '+%F %T') manual expired, resuming schedule" >> $STATE/schedule.log
    rm -f $STATE/mode $STATE/expires
fi
h=$(date +%H)
[ $h -ge 6 ] && [ $h -lt 24 ] && want=host || want=device
cur=$(cat $RS 2>/dev/null)
[ "$cur" = "$want" ] && exit 0
echo $want > $RS; sleep 2
[ "$(cat $RS 2>/dev/null)" = "$want" ] && \
    echo "$(date '+%F %T') check: corrected to $want" >> $STATE/schedule.log
